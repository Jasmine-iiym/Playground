{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [
    ".next",
    ".agents",
    ".vscode",
    "node_modules",
    "out",
    "build",
    "next-env.d.ts",
    "package-lock.json",
    "*.md"
  ]
}
